#!/bin/sh -x

# Install the Libtool macro files before aclocal builds aclocal.m4. Otherwise
# the result can depend on whether a matching Libtool installation happens to
# be visible in aclocal's global search path.
#
# Respect an explicitly selected GNU libtoolize. On macOS GNU Libtool is
# conventionally installed as glibtoolize to avoid colliding with Apple's
# unrelated /usr/bin/libtool.
if test -n "$LIBTOOLIZE"
then
  "$LIBTOOLIZE" --copy --force || exit 1
elif command -v glibtoolize >/dev/null 2>&1
then
  # macOS installs GNU Libtool under the collision-free glibtoolize name.
  # Prefer it wherever present instead of spawning uname just to identify Darwin.
  glibtoolize --copy --force || exit 1
elif command -v libtoolize >/dev/null 2>&1
then
  libtoolize --copy --force || exit 1
else
  echo "bootstrap: GNU libtoolize/glibtoolize not found" >&2
  exit 1
fi

aclocal -I .
autoconf
automake --foreign --add-missing --copy --include-deps
